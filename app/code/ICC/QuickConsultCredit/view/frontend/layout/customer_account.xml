<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- QCC-CUSTOMER-001: My Account navigation entry -->
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface"
                   name="customer-account-navigation-quick-consult-credit-link">
                <arguments>
                    <argument name="path" xsi:type="string">quickconsultcredit/account/index</argument>
                    <argument name="label" xsi:type="string" translate="true">Quick Consult Credit</argument>
                    <argument name="sortOrder" xsi:type="number">130</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
