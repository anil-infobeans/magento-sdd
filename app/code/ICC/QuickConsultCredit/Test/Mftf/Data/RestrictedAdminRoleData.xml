<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:mftf:DataGenerator/etc/dataProfileSchema.xsd">
    <!--
        A role that can manage customers but is deliberately NOT granted
        ICC_QuickConsultCredit::manage, for QCC-ADMIN-009 unauthorized-administrator
        rejection coverage.
    -->
    <entity name="RoleWithoutQuickConsultCreditManage">
        <data key="name" unique="suffix">Role Without QCC Manage</data>
        <data key="rolename" unique="suffix">Role Without QCC Manage</data>
        <data key="resourceAccess">Custom</data>
        <data key="all">0</data>
        <data key="current_password">{{_ENV.MAGENTO_ADMIN_PASSWORD}}</data>
        <data key="resource">['Magento_Customer::customer','Magento_Customer::manage']</data>
    </entity>
</entities>
